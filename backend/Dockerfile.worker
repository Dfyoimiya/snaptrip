# ===== Agent Worker 生产镜像 =====
# Phase 3-5: Celery Worker 异步执行 LangGraph
#
# 职责:
#   - submit_plan  — 异步运行全链路 Agent (9 节点)
#   - confirm_plan — 人机协同恢复执行
#   - OrphanReaper — 定时清理孤儿资源（Phase 5 RedBeat）
#
# 启动:
#   celery -A app.celery_app worker --pool=gevent --concurrency=100 -Q agent
#
# 环境变量:
#   MARKETPLACE_MODE  — mock | live | hybrid
#   SNAPTRIP_MARKETPLACE_URL  — Marketplace API base URL
#   REDIS_URL  — Celery broker + result backend

# ===== Development Stage =====
FROM python:3.11-slim AS development

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

COPY . .

# Agent 是 IO 密集型（LLM HTTP + Marketplace HTTP + PostgreSQL）
# 使用 gevent pool 兼容 LangGraph 全链路 async/await
CMD ["uv", "run", "celery", "-A", "app.celery_app", "worker", "--pool=gevent", "--concurrency=100", "-Q", "agent", "-l", "info"]


# ===== Production Stage =====
FROM python:3.11-slim AS production

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

COPY . .

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

# Agent 是 IO 密集型（LLM HTTP + Marketplace HTTP + PostgreSQL）
# 使用 gevent pool 兼容 LangGraph 全链路 async/await
CMD ["uv", "run", "celery", "-A", "app.celery_app", "worker", "--pool=gevent", "--concurrency=100", "-Q", "agent", "-l", "info"]
