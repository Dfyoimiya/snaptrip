# ===== Agent Worker 生产镜像 =====
# Phase 3-5: Celery Worker 异步执行 LangGraph
#
# 职责:
#   - submit_plan  — 异步运行全链路 Agent (9 节点)
#   - confirm_plan — 人机协同恢复执行
#   - OrphanReaper — 定时清理孤儿资源（Phase 5 RedBeat）
#
# 启动:
#   celery -A marketplace.app.celery_app worker --pool=gevent --concurrency=100 -Q agent
#
# 环境变量:
#   MARKETPLACE_MODE  — mock | live | hybrid
#   SNAPTRIP_MARKETPLACE_URL  — Marketplace API base URL
#   REDIS_URL  — Celery broker + result backend
#
# 构建上下文: repo root (monorepo workspace)

# ===== Shared Base Stage =====
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy
# venv 放到 /app 外面，避免 dev bind mount 覆盖
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ── 依赖安装层（利用 Docker 缓存）──
# 先复制 workspace 根配置 + lock file
COPY pyproject.toml uv.lock ./

# 复制各 workspace member 的 pyproject.toml + 源码（setuptools 构建需要完整源码）
COPY backend/pyproject.toml backend/
COPY backend/marketplace/ backend/marketplace/
COPY shared/pyproject.toml shared/
COPY shared/snaptrip_shared/ shared/snaptrip_shared/
COPY agent/pyproject.toml agent/
COPY agent/src/ agent/src/

RUN uv sync --package snaptrip-backend --no-dev

# ===== Development Stage =====
FROM base AS development

# 复制全部源码（覆盖/补充依赖层已复制的部分）
COPY backend/ backend/
COPY shared/ shared/
COPY agent/ agent/

CMD ["celery", "-A", "marketplace.app.celery_app", "worker", "--pool=gevent", "--concurrency=100", "-Q", "agent", "-l", "info"]


# ===== Production Stage =====
FROM base AS production

# 复制全部源码
COPY backend/ backend/
COPY shared/ shared/
COPY agent/ agent/

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

CMD ["celery", "-A", "marketplace.app.celery_app", "worker", "--pool=gevent", "--concurrency=100", "-Q", "agent", "-l", "info"]
