# ===== Gateway 生产镜像 =====
# Phase 5: 薄 HTTP 层 — 仅 FastAPI + uvicorn，不含 Celery
#
# 职责:
#   - POST /api/v1/plan/create   → Celery 异步派发 → 202
#   - GET  /api/v1/plan/{id}/stream → SSE (Redis Pub/Sub)
#   - POST /api/v1/plan/{id}/confirm → Celery 恢复 → 202
#   - JWT Auth + Rate Limit
#
# 环境变量:
#   MARKETPLACE_MODE  — mock | live | hybrid
#   SNAPTRIP_MARKETPLACE_URL  — Marketplace API base URL

FROM python:3.11-slim AS production

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy

COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev

COPY . .

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=15s \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
