# ===== Gateway 生产镜像 =====
# Phase 5: 薄 HTTP 层 — 仅 FastAPI + uvicorn，不含 Celery
#
# 职责:
#   - POST /api/v1/plan/create   → Celery 异步派发 → 202
#   - GET  /api/v1/plan/{id}/stream → SSE (Redis Pub/Sub)
#   - POST /api/v1/plan/{id}/confirm → Celery 恢复 → 202
#   - JWT Auth + Rate Limit
#
# 环境变量:
#   MARKETPLACE_MODE  — mock | live | hybrid
#   SNAPTRIP_MARKETPLACE_URL  — Marketplace API base URL
#
# 构建上下文: repo root (monorepo workspace)

# ===== Shared Base Stage =====
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

ENV UV_LINK_MODE=copy
# venv 放到 /app 外面，避免 dev bind mount 覆盖
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ── 依赖安装层（利用 Docker 缓存）──
# 先复制 workspace 根配置 + lock file
COPY pyproject.toml uv.lock ./

# 复制各 workspace member 的 pyproject.toml + 源码（setuptools 构建需要完整源码）
COPY backend/pyproject.toml backend/
COPY backend/marketplace/ backend/marketplace/
COPY shared/pyproject.toml shared/
COPY shared/snaptrip_shared/ shared/snaptrip_shared/
COPY agent/pyproject.toml agent/
COPY agent/src/ agent/src/

RUN uv sync --package snaptrip-backend --no-dev

# ===== Development Stage =====
FROM base AS development

# 复制全部源码（覆盖/补充依赖层已复制的部分）
COPY backend/ backend/
COPY shared/ shared/
COPY agent/ agent/

EXPOSE 8000

WORKDIR /app/backend
CMD ["uvicorn", "marketplace.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]


# ===== Production Stage =====
FROM base AS production

# 复制全部源码
COPY backend/ backend/
COPY shared/ shared/
COPY agent/ agent/

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=3 --start-period=15s \
    CMD curl -f http://localhost:8000/health || exit 1

WORKDIR /app/backend
CMD ["uvicorn", "marketplace.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
