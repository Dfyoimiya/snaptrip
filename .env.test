# ===== SnapTrip 测试环境配置 =====
# 使用方式:
#   make test-up        → 启动 test DB + Redis
#   make test-backend   → 运行全部后端测试
#   make test-down      → 停止并清理

# ===== App =====
APP_ENV=test
APP_DEBUG=false
APP_SECRET_KEY=test-secret-key-not-for-prod
JWT_SECRET_KEY=test-jwt-secret-key-not-for-prod
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=WARNING
LOG_FORMAT=json

# ===== LLM (测试用占位符) =====
LITELLM_MASTER_KEY=sk-litellm-test-placeholder
DEEPSEEK_API_KEY=placeholder
KIMI_API_KEY=placeholder
LLM_DEFAULT_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ===== Database (Test) =====
POSTGRES_USER=snaptrip
POSTGRES_PASSWORD=snaptrip_dev_pass
POSTGRES_TEST_DB=snaptrip_test
DATABASE_TEST_URL=postgresql+asyncpg://snaptrip:snaptrip_dev_pass@localhost:5433/snaptrip_test

# ===== Redis (Test) =====
REDIS_URL=redis://localhost:6380/0
REDIS_TEST_URL=redis://localhost:6380/0
REDIS_POOL_SIZE=5

# ===== Mock API =====
MOCK_API_BASE_URL=http://localhost:8001
MOCK_API_TIMEOUT=3
MOCK_FAULT_RATE=0
MOCK_DELAY_RATE=0

# ===== Agent =====
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=2
AGENT_LLM_TEMPERATURE=0.3
RATE_LIMIT_IP_PER_MIN=1000
RATE_LIMIT_USER_PER_MIN=1000
