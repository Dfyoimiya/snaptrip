' ==================== 关系定义 ====================

' ── 组织权限域内部 ──

UmsResourceCategory "1" -- "0..*" UmsResource : 包含 >
UmsMenu "1" -- "0..*" UmsMenu : parent > child
UmsAdmin "*" -- "*" UmsRole
UmsRole "*" -- "*" UmsMenu
UmsRole "*" -- "*" UmsResource

' ── 商品域内部 ──

PmsBrand "1" -- "0..*" PmsProduct : 拥有 >
PmsProductCategory "1" -- "0..*" PmsProduct : 分类 >
PmsProductCategory "1" -- "0..*" PmsProductCategory : parent > child
PmsProductAttributeCategory "1" -- "0..*" PmsProductAttribute : 包含 >
PmsProduct "1" *-- "1..*" SkuStock

' ── 订单域内部 ──

OmsOrder "1" *-- "1..*" OmsOrderItem
OmsOrder "1" *-- "0..*" OmsOrderOperateHistory
OmsOrderReturnApply "0..*" -- "1" OmsOrderReturnReason : 选择原因 >
OmsOrderReturnApply "*" -- "1" OmsCompanyAddress : 退货至 >

' ════════════════════════════════════
' 跨域关系
' ════════════════════════════════════

' 订单 ↔ 商品
OmsOrderItem "*" --> "1" PmsProduct : 关联商品
OmsOrderReturnApply "*" --> "1" PmsProduct : 退货商品

' 订单 ↔ 营销
OmsOrder "0..1" --> "0..1" SmsCoupon : 使用 >

' 订单 ↔ 组织权限
OmsOrderOperateHistory "*" --> "1" UmsAdmin : 操作人 >

' 营销 ↔ 商品（优惠券指定商品/分类）
SmsCoupon "1" -- "0..*" CouponProductRelation : 指定商品 >
SmsCoupon "1" -- "0..*" CouponProductCategoryRelation : 指定分类 >
CouponProductRelation "*" --> "1" PmsProduct
CouponProductCategoryRelation "*" --> "1" PmsProductCategory

' 营销 ↔ 商品（秒杀/推荐）
SmsFlashPromotionProductRelation "*" --> "1" PmsProduct : 关联商品
SmsHomeNewProduct "*" --> "1" PmsProduct : 推荐商品
SmsHomeRecommendProduct "*" --> "1" PmsProduct : 推荐商品

' 营销 ↔ 品牌
SmsHomeBrand "*" --> "1" PmsBrand : 推荐品牌

' 秒杀域内部
SmsFlashPromotion "1" -- "0..*" SmsFlashPromotionProductRelation
SmsFlashPromotionSession "1" -- "0..*" SmsFlashPromotionProductRelation

' 内容 ↔ 专题分类
CmsSubjectCategory "1" -- "0..*" CmsSubject : 包含 >
SmsHomeRecommendSubject "*" --> "1" CmsSubject : 推荐专题

@enduml
