# ===== App =====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== LiteLLM Gateway =====
# API 密钥由 litellm-proxy 消费，Python 服务只需 LITELLM_BASE_URL
LITELLM_MASTER_KEY=<sk-litellm-admin-xxx>
DEEPSEEK_API_KEY=<sk-your-deepseek-key>
KIMI_API_KEY=<sk-your-kimi-key>
LLM_DEFAULT_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>

# ===== Database (Development) =====
POSTGRES_USER=snaptrip
POSTGRES_PASSWORD=<set-your-db-password>
POSTGRES_DEV_DB=snaptrip_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:-snaptrip}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DEV_DB:-snaptrip_dev}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Database (Test) =====
POSTGRES_TEST_DB=snaptrip_test
DATABASE_TEST_URL=postgresql+asyncpg://${POSTGRES_USER:-snaptrip}:${POSTGRES_PASSWORD}@localhost:5433/${POSTGRES_TEST_DB:-snaptrip_test}

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_URL=redis://localhost:6380/0
REDIS_POOL_SIZE=10

# ===== Docker =====
BUILD_TARGET=production
COMPOSE_PROJECT_NAME=snaptrip

# ===== Marketplace =====
MARKETPLACE_MODE=mock
SNAPTRIP_MARKETPLACE_URL=http://marketplace:8000

# ===== Agent =====
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=2
AGENT_LLM_TEMPERATURE=0.3
RATE_LIMIT_IP_PER_MIN=100
RATE_LIMIT_USER_PER_MIN=300
