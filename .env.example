# ===== LLM =====
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v3
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://snaptrip:snaptrip@localhost:5432/snaptrip
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ===== Mock API =====
MOCK_API_BASE_URL=http://localhost:8001
MOCK_API_TIMEOUT=3

# ===== Agent =====
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=2
AGENT_LLM_TEMPERATURE=0.3

# ===== App =====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_me_in_production
LOG_LEVEL=INFO
LOG_FORMAT=json
