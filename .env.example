# ===== LLM =====
OPENROUTER_API_KEY=<sk-or-your-openrouter-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v3
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ===== Database =====
POSTGRES_USER=snaptrip
POSTGRES_PASSWORD=<set-your-db-password>
POSTGRES_DB=snaptrip
# 本地开发用 localhost，Docker 内用 db
DATABASE_URL=postgresql+asyncpg://snaptrip:<set-your-db-password>@localhost:5432/snaptrip
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis =====
# 本地开发用 localhost，Docker 内用 redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ===== Mock API =====
# 本地开发用 localhost，Docker 内用 mock-server
MOCK_API_BASE_URL=http://localhost:8001
MOCK_API_TIMEOUT=3

# ===== Docker =====
BUILD_TARGET=production
COMPOSE_PROJECT_NAME=snaptrip

# ===== Agent =====
AGENT_TIMEOUT=300
AGENT_MAX_RETRIES=2
AGENT_LLM_TEMPERATURE=0.3

# ===== App =====
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=<generate-with-openssl-rand-hex-32>
LOG_LEVEL=INFO
LOG_FORMAT=json
