{# 分享卡片 Jinja2 模板 —— 计划摘要 + 时间轴 + 预订状态 #}
{# 远期: Playwright 将渲染后的 HTML 截图生成微信分享卡片 #}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>SnapTrip 计划 - {{ plan_id }}</title>
  <style>
    body { font-family: 'PingFang SC', sans-serif; background: #1a1a2e; color: #eee; padding: 24px; max-width: 400px; margin: 0 auto; }
    .card { background: #16213e; border-radius: 16px; padding: 20px; }
    h2 { color: #e94560; margin: 0 0 4px; }
    .sub { color: #888; font-size: 13px; margin-bottom: 16px; }
    .slot { border-left: 3px solid #e94560; padding: 8px 12px; margin: 12px 0; }
    .slot .time { color: #e94560; font-weight: 600; }
    .slot .name { font-size: 16px; margin: 2px 0; }
    .slot .meta { color: #888; font-size: 12px; }
    .summary { border-top: 1px solid #333; margin-top: 16px; padding-top: 12px; }
    .summary .row { display: flex; justify-content: space-between; padding: 4px 0; }
    .success { color: #4ecca3; }
    .pending { color: #ffd700; }
    .failed { color: #e94560; }
  </style>
</head>
<body>
  <div class="card">
    <h2>{{ title | default("SnapTrip 计划") }}</h2>
    <p class="sub">{{ message }}</p>

    {% for slot in slots %}
    <div class="slot">
      <div class="time">{{ slot.get("time_range", {}).get("start", "")[:16] | default("") }}</div>
      <div class="name">{{ slot.get("poi", {}).get("name", "") }}</div>
      <div class="meta">{{ slot.get("action", "") | default("arrive") }} · ¥{{ slot.get("estimated_cost", 0) }}</div>
    </div>
    {% endfor %}

    <div class="summary">
      {% if slots %}
      <div class="row"><span>活动数</span><span>{{ slots | length }} 个</span></div>
      {% endif %}
      {% if total_cost %}
      <div class="row"><span>预估费用</span><span>¥{{ total_cost }}</span></div>
      {% endif %}
      {% if booked_count is defined %}
      <div class="row"><span>已预订</span><span class="{{ 'success' if booked_count > 0 else 'pending' }}">{{ booked_count }} 项</span></div>
      {% endif %}
    </div>
  </div>
</body>
</html>
