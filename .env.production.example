# 复制为 .env 后填写真实值。不要把 .env 提交到 Git。

# ===== Public domains =====
SITE_DOMAIN=snaptrip.example.com
ADMIN_DOMAIN=admin.snaptrip.example.com
CORS_ORIGINS=https://snaptrip.example.com,https://admin.snaptrip.example.com

# ===== App =====
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=<generate-with-openssl-rand-hex-32>
JWT_SECRET_KEY=<generate-with-openssl-rand-hex-32>
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===== Database / Redis =====
POSTGRES_USER=snaptrip
POSTGRES_PASSWORD=<generate-a-strong-password>
POSTGRES_DEV_DB=snaptrip
REDIS_PASSWORD=<generate-a-strong-password>

# ===== LiteLLM =====
LITELLM_MASTER_KEY=<generate-with-openssl-rand-hex-32>
DEEPSEEK_API_KEY=<your-deepseek-key>
KIMI_API_KEY=<your-kimi-key-or-empty>
LLM_DEFAULT_MODEL=deepseek-v4-pro
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ===== Frontends =====
# Keep API requests same-origin. Public Nginx forwards /api/ to FastAPI.
ADMIN_API_BASE_URL=/api/v1
MALL_WEB_API_BASE_URL=

# ===== Runtime =====
BUILD_TARGET=production
COMPOSE_PROJECT_NAME=snaptrip
SNAPTRIP_MARKETPLACE_URL=http://marketplace:8000
AGENT_TIMEOUT=300
HF_MODEL_CACHE=/opt/snaptrip/huggingface
